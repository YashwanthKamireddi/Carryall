[Unit]
Description=Carryall clipboard daemon (background capture + E2E sync)
After=graphical-session.target
PartOf=graphical-session.target

[Service]
# Sync settings come from ~/.config/clip/config.toml (account/secret/relay).
ExecStart=%h/.local/bin/carryall daemon
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target

# Install:
#   cp contrib/carryall-daemon.service ~/.config/systemd/user/
#   systemctl --user enable --now carryall-daemon
